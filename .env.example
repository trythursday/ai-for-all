# Required.

# Signing secret for captcha challenges. Must be at least 16 bytes.
# Generate one with: bun run src/main.ts --generate .env
CAP_SECRET=

# Any OpenAI-compatible upstream.
UPSTREAM_URL=https://openrouter.ai/api/v1
UPSTREAM_SK=

# Upstream model slugs behind the public aliases.
UPSTREAM_MODEL_LOCAL=qwen/qwen3.8-flash
UPSTREAM_MODEL_FRONTIER=deepseek/deepseek-v4.1-flash

# Optional. Defaults shown.

# PORT=3000

# Proof-of-work difficulty. `count` scales linearly with solve time; raising
# `difficulty` multiplies the work by 16 each step, so tune `count` first.
# The default takes roughly 15-20s on a low-end phone.
# CHALLENGE_COUNT=100
# CHALLENGE_SIZE=32
# CHALLENGE_DIFFICULTY=4

# Per-request token budgets. Input and output are estimated at 4 chars/token.
# MAX_INPUT_TOKENS=16384
# MAX_OUTPUT_TOKENS=16384
# MAX_CONTEXT_TOKENS=32768

# Stop issuing requests once the upstream reports this much spend for the UTC
# day. Paired with the balance in your account, it paces how long it lasts.
# DAILY_BUDGET_USD=0.25

# Shown on the homepage as the percentage of balance left. Set it to what you
# topped up for the month.
# MONTHLY_BUDGET_USD=5
